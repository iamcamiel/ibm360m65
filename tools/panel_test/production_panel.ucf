NET "disp_shift_o<3>" LOC="P34" | IOSTANDARD=LVCMOS25 | DRIVE=12 | SLEW=SLOW;
NET "disp_shift_o<4>" LOC="N34" | IOSTANDARD=LVCMOS25 | DRIVE=12 | SLEW=SLOW;
NET "disp_shift_o<5>" LOC="AA34" | IOSTANDARD=LVCMOS25 | DRIVE=12 | SLEW=SLOW;
NET "disp_shift_i<0>" LOC="AD32" | IOSTANDARD=LVCMOS25;
